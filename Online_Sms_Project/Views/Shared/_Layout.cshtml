@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Materio Premium Hub</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <aside class="app-sidebar d-flex flex-column justify-content-between py-3">
        <div>
            <div class="d-flex align-items-center justify-content-between px-4 mb-4">
                <div class="d-flex align-items-center">
                    <div class="me-2 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="#8C57FF" />
                            <path d="M2 17L12 22L22 17V12L12 17L2 12V17Z" fill="#AA80FF" />
                        </svg>
                    </div>
                    <span class="fs-5 fw-bold text-dark text-uppercase tracking-wide" style="letter-spacing: 0.3px;">Online SMS</span>
                </div>
                <i class="bi bi-record-circle text-muted fs-5 d-none d-lg-block"></i>
            </div>

            <div class="mb-2">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active-gradient" : "")"
                           href="@Url.Action("Index", "Home")">
                            <i class="bi bi-grid-1x2 me-3"></i>Dashboards
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Messages" ? "active-gradient" : "")"
                           href="@Url.Action("Index", "Messages")">
                            <i class="bi bi-chat-left-text me-3"></i>Messages
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Friends" ? "active-gradient" : "")"
                           href="@Url.Action("Index", "Friends")">
                            <i class="bi bi-people me-3"></i>Friends & Requests
                        </a>
                    </li>
                </ul>
            </div>

            <div class="mt-4">
                <small class="text-uppercase text-muted fw-bold d-block mb-2 px-4" style="font-size: 0.68rem; letter-spacing: 0.8px; opacity: 0.6;">Account Services</small>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="sidebar-link" href="#">
                            <i class="bi bi-person-gear me-3"></i>Profile Setup
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="sidebar-link justify-content-between" href="#">
                            <span><i class="bi bi-lightning-charge me-3"></i>Paid Services</span>
                            <span class="badge bg-warning text-dark rounded-pill px-2" style="font-size: 0.62rem; font-weight: 700;">PREMIUM</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="px-4 border-top pt-3">
            <a href="@Url.Action("Logout", "Account")" class="text-decoration-none text-danger fw-semibold d-flex align-items-center" style="font-size: 0.9rem;">
                <i class="bi bi-box-arrow-left me-3 fs-5"></i>
                <span>Sign Out</span>
            </a>
        </div>
    </aside>

    <div class="app-header-container">
        <header class="app-header d-flex align-items-center px-3">
            <div class="d-flex align-items-center gap-2 ms-auto">
                <button type="button" class="btn btn-link p-2 text-dark text-decoration-none shadow-none"><i class="bi bi-translate fs-5"></i></button>
                <button type="button" class="btn btn-link p-2 text-dark text-decoration-none shadow-none"><i class="bi bi-brightness-high fs-5"></i></button>
                <button type="button" class="btn btn-link p-2 text-dark text-decoration-none shadow-none"><i class="bi bi-bookmark-star fs-5"></i></button>
                <button type="button" class="btn btn-link p-2 text-dark text-decoration-none shadow-none position-relative">
                    <i class="bi bi-bell fs-5"></i>
                    <span class="position-absolute p-1 bg-success border border-light rounded-circle" style="top: 10px; right: 10px;"></span>
                </button>

                <div class="ps-2 ms-1 border-start">
                    @{
                        var username = Context.Session.GetString("Username");
                        var initial = !string.IsNullOrEmpty(username) ? username.Substring(0, 1).ToUpper() : "U";
                    }
                    <a href="@Url.Action("Profile", "Account")" class="text-decoration-none">
                        <div class="bg-materio text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" title="Profile Settings" style="width: 38px; height: 38px; font-size: 0.95rem; background-color: #8C57FF;">
                            @initial
                        </div>
                    </a>
                </div>
            </div>
        </header>
    </div>

    <main class="app-main-content">
        <div class="container-fluid p-0">
            @RenderBody()
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>