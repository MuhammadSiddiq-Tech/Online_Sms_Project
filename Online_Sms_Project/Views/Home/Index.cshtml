@model IEnumerable<Online_Sms_Project.Models.Article>
@{
    ViewData["Title"] = "Home Feed";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded shadow-sm border">
                <div>
                    <h4 class="fw-bold text-dark mb-0">🏠 Global Dashboard Feed</h4>
                    <small class="text-muted">Explore real-time thoughts from community</small>
                </div>
                <a href="/Articles/Create" class="btn btn-primary shadow-sm btn-sm fw-bold px-3 py-2">
                    <i class="bi bi-plus-circle-fill me-1"></i> Write an Article
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success p-2 small shadow-sm">@TempData["Success"]</div>
            }

            <div class="articles-feed">
                @if (Model == null || !Model.Any())
                {
                    <div class="text-center bg-white p-5 rounded border shadow-sm text-muted">
                        <i class="bi bi-card-text display-4 mb-2 d-block text-secondary" style="opacity: 0.4;"></i>
                        <h5>No updates available!</h5>
                        <p class="small text-muted mb-0">Click "Write an Article" to post the first update.</p>
                    </div>
                }
                else
                {
                    @foreach (var article in Model)
                    {
                        <div class="card shadow-sm border border-light-subtle mb-4 bg-white rounded-3">
                            <div class="card-body p-4">

                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                        @(!string.IsNullOrEmpty(article.Author?.Username) ? article.Author.Username.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <div class="ms-3">
                                        <h6 class="mb-0 fw-bold text-dark">👤 @article.Author?.Username</h6>
                                        <small class="text-muted" style="font-size: 0.75rem;">
                                            <i class="bi bi-clock me-1"></i> @article.PublishedAt.ToLocalTime().ToString("g")
                                        </small>
                                    </div>
                                </div>

                                <h4 class="card-title fw-bold text-dark mb-2">@article.Title</h4>
                                <p class="card-text text-secondary text-break" style="white-space: pre-line; line-height: 1.5; font-size: 0.95rem;">
                                    @article.Content
                                </p>
                            </div>
                            <div class="card-footer bg-light border-0 px-4 py-2 d-flex justify-content-between align-items-center">
                                <span class="badge bg-success-subtle text-success small px-2 py-1"><i class="bi bi-globe"></i> Community Post</span>
                                <button class="btn btn-link btn-sm text-decoration-none text-muted p-0" onclick="this.classList.toggle('text-danger')"><i class="bi bi-heart-fill me-1"></i> Like</button>
                            </div>
                        </div>
                    }
                }
            </div>

        </div>
    </div>
</div>