@model IEnumerable<Online_Sms_Project.Models.User>
@{
    ViewData["Title"] = "Friends Hub";
    var incoming = ViewBag.IncomingRequests as IEnumerable<Online_Sms_Project.Models.FriendRequest>;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-people-fill text-primary me-2"></i>Friends Network</h2>

        <form asp-action="FindFriends" method="get" class="d-flex" style="max-width: 400px;">
            <div class="input-group">
                <input type="text" name="searchPhone" class="form-control form-control-sm" placeholder="Search phone number to add..." required />
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search"></i> Find</button>
            </div>
        </form>
    </div>
    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger p-2 small">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success p-2 small">@TempData["Success"]</div>
    }

    <div class="row mt-4">
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm friends-card">
                <div class="card-header-custom bg-warning text-dark fw-bold">
                    <i class="bi bi-bell-fill me-2"></i> Pending Friend Requests
                </div>
                <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                    @if (incoming == null || !incoming.Any())
                    {
                        <div class="text-center p-4 text-muted small">
                            <i class="bi bi-chat-left-dots d-block mb-1 fs-4"></i> Koi nayi friend request nahi hai.
                        </div>
                    }
                    else
                    {
                        @foreach (var req in incoming)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center p-3 friend-list-item">
                                <div>
                                    <span class="fw-bold d-block text-dark">👤 @req.Sender?.Username</span>
                                    <small class="text-muted">📱 @req.Sender?.PhoneNumber</small>
                                </div>
                                <form asp-action="AcceptRequest" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@req.Id" />
                                    <button type="submit" class="btn btn-success btn-xs px-3 shadow-sm">
                                        <i class="bi bi-check-lg"></i> Accept
                                    </button>
                                </form>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-md-7 mb-4">
            <div class="card shadow-sm friends-card">
                <div class="card-header-custom bg-dark text-white fw-bold">
                    <i class="bi bi-person-check-fill me-2"></i> Confirmed Friends Network
                </div>
                <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center p-5 text-muted">
                            <i class="bi bi-envelope-open display-4 d-block mb-2" style="opacity:0.2;"></i>
                            <span>Aapka abhi tak koi official dost nahi bana.<br><small>Upar search bar se doston ko add karein.</small></span>
                        </div>
                    }
                    else
                    {
                        @foreach (var friend in Model)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center p-3 border-bottom friend-list-item">
                                <div>
                                    <h6 class="fw-bold mb-0 text-success">💚 @friend.Username</h6>
                                    <small class="text-muted">📱 @friend.PhoneNumber</small>
                                </div>
                                <a href="/Messages/index" class="btn btn-sm btn-outline-primary px-3 shadow-sm rounded-pill">
                                    <i class="bi bi-chat-dots-fill me-1"></i> Chat Now
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>