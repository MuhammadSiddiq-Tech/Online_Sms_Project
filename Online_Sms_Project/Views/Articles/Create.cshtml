@{
    ViewData["Title"] = "Write New Article";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white fw-bold">
            <i class="bi bi-pencil-square me-2"></i> Create New Article
        </div>
        <div class="card-body p-4">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger p-2 small">@TempData["Error"]</div>
            }

            <form asp-action="Create" asp-controller="Articles" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Article Title</label>
                    <input type="text" name="title" class="form-control" placeholder="Enter an interesting title..." required autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Article Content</label>
                    <textarea name="content" rows="8" class="form-control" placeholder="What's on your mind? Write here..." required></textarea>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a href="/Home/Index" class="btn btn-outline-secondary btn-sm px-3">Cancel</a>
                    <button type="submit" class="btn btn-success btn-sm px-4 shadow-sm fw-bold">Publish Post</button>
                </div>
            </form>
        </div>
    </div>
</div>